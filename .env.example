# Public URL of the site (no trailing slash). The OAuth redirect is BASE_URL/auth/google/callback —
# add it to "Authorized redirect URIs" of the OAuth client in Google Cloud Console.
BASE_URL=http://localhost:8080

# Google OAuth client (from the client_secret_*.json downloaded from Google Cloud Console)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me

# Comma-separated Google emails that can open /admin
ADMIN_EMAILS=you@gmail.com

# Postgres password used by docker-compose
POSTGRES_PASSWORD=change-me

# Optional
# Email for rights holders' takedown requests, shown on /legal
# CONTACT_EMAIL=rights@example.com
# APP_PORT=8080
# ATTEMPTS_PER_DAY=10
# CLIP_SECONDS=30
# MAX_UPLOAD_MB=1024
